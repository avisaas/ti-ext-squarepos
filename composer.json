{
    "name": "igniterlabs/ti-ext-squarepos",
    "type": "tastyigniter-package",
    "description": "Sync menu and order data between TastyIgniter and Square POS.",
    "license": "MIT",
    "authors": [
        {
            "name": "Igniter Labs Team"
        }
    ],
    "require": {
        "square/square": "~47.0",
        "tastyigniter/core": "^v4.0"
    },
    "require-dev": {
      "larastan/larastan": "^3.0",
      "laravel/pint": "^1.2",
      "pestphp/pest-plugin-laravel": "^4.0",
      "rector/rector": "^2.0",
      "sampoyigi/testbench": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "IgniterLabs\\SquarePOS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IgniterLabs\\SquarePOS\\Tests\\": "tests/"
        }
    },
    "extra": {
        "tastyigniter-extension": {
            "code": "igniterlabs.squarepos",
            "name": "Square POS for TastyIgniter",
            "icon": {
                "image": "icon.svg",
                "backgroundColor": "#FFFFFF",
                "color": "#FFFFFF"
            },
            "homepage": "https://tastyigniter.com/marketplace/item/igniterlabs-squarepos"
        },
        "branch-alias": {
            "dev-master": "4.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "composer/installers": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test:lint": "vendor/bin/pint --test --ansi",
        "test:lint-fix": "vendor/bin/pint --ansi",
        "test:refactor": "vendor/bin/rector process --dry-run --ansi",
        "test:refactor-fix": "vendor/bin/rector process --ansi",
        "test:static": "vendor/bin/phpstan analyse --memory-limit=1056M --ansi",
        "test:static-fix": "vendor/bin/phpstan --generate-baseline --memory-limit=1056M --ansi",
        "test:pest": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage --min=100 --compact",
        "test:type-coverage": "vendor/bin/pest --type-coverage --min=100",
        "test": [
            "@test:refactor",
            "@test:static",
            "@test:lint",
            "@test:coverage"
        ]
    }
}
