{
  "name": "igniterlabs/ti-ext-squarepos",
  "type": "tastyigniter-package",
  "description": "Sync menu and order data between TastyIgniter and Square POS.",
  "license": "MIT",
  "authors": [
    {
      "name": "Igniter Labs Team"
    }
  ],
  "require": {
    "square/square": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "pestphp/pest": "^2.5",
    "laravel/pint": "^1.2",
    "nunomaduro/larastan": "^2.4.0",
    "orchestra/testbench": "^8.5",
    "pestphp/pest-plugin-laravel": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "IgniterLabs\\SquarePOS\\": "src/"
    }
  },
  "extra": {
    "tastyigniter-extension": {
      "code": "igniterlabs.squarepos",
      "name": "Square POS for TastyIgniter",
      "icon": {
        "image": "icon.svg",
        "backgroundColor": "#FFFFFF",
        "color": "#FFFFFF"
      },
      "homepage": "https://tastyigniter.com/marketplace/item/igniterlabs-squarepos"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  }
}